# Database
POSTGRES_DB=banksync
POSTGRES_USER=banksync
POSTGRES_PASSWORD=banksync_secret_change_me

# Security
SECRET_KEY=change-me-in-production-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Salt Edge (sandbox)
SALT_EDGE_APP_ID=your_salt_edge_app_id
SALT_EDGE_SECRET=your_salt_edge_secret
SALT_EDGE_BASE_URL=https://www.saltedge.com/api/v5

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:80
